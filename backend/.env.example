# Backend Environment Variables
PORT=5000
NODE_ENV=development
JWT_SECRET=genericmed-secure-jwt-secret-key-2026

# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/genericmed?appName=Cluster0"

# GEMINI_API_KEY: Required for Gemini AI clinical drug interaction & natural language features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for self-referential links / webhooks
APP_URL="http://localhost:5000"
